{
  "manifest_version": 3,
  "name": "Margins Web Clipper",
  "version": "0.1.0",
  "description": "Save the current page to your Margins library with its formatting intact.",
  "permissions": ["activeTab", "scripting", "storage", "contextMenus"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "background": { "service_worker": "background.js" },
  "action": {
    "default_title": "Save to Margins",
    "default_popup": "popup.html"
  },
  "icons": {
    "128": "icon-128.png"
  }
}
